---
import ComponentLayout from '../../layouts/ComponentLayout.astro';
---

<ComponentLayout title="Coil Editor Components">
  <div class="prose">
    <h1>Coil Editor Components</h1>
    <p>These components form the structured DOM for the Three-Layer Coil editor interface.</p>
    
    <script>
      import '../../../components/src/index.ts';
    </script>
    
    <section id="coil-component">
      <h2>&lt;ppt-coil&gt;</h2>
      <p>The root container for the coil editor. It hosts the layers and manages cross-layer event bubbling.</p>
    </section>

    <section id="grid-coordinator">
      <h2>&lt;ppt-grid-coordinator&gt;</h2>
      <p>A headless utility that listens to column width configurations and broadcasts them to child phrase editors for CSS grid alignment.</p>
    </section>

    <section id="coil-layer">
      <h2>&lt;ppt-coil-layer&gt;</h2>
      <p>A semantic grouping layer (e.g., <code>layer="rhythm"</code>). Used by the PlaybackScheduler and CSS to target specific musical functions.</p>
    </section>

    <section id="coil-row">
      <h2>&lt;ppt-coil-row&gt;</h2>
      <p>A container for a single phrase editor, supporting multiple rows per layer (e.g., for polyrhythms or multi-voice harmony).</p>
    </section>

    <section id="phrase-editor">
      <h2>&lt;ppt-phrase-editor&gt;</h2>
      <p>The actual interactive grid where glyph tokens are parsed, rendered, and edited.</p>
    </section>
    
    <section id="coil-cursor">
      <h2>&lt;ppt-coil-cursor&gt;</h2>
      <p>A blinking indicator signifying which row/editor is currently active and receiving input.</p>
    </section>
  </div>
</ComponentLayout>
