    overflow: hidden;
  }
  
  main {
    padding: 0 !important;
    height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Dynamically adjust height to exactly fit the remaining space below header */
  header {
    flex-shrink: 0;
  }
</style>
